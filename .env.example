# LOCAL DEVELOPMENT ONLY. Copy to .env.
#
# Do NOT paste this file into a Vercel or Railway dashboard. Exactly one of these variables is
# yours to set on a deployment, and the other two are the platform's -- setting those by hand is
# how this repo broke the first time it was deployed: a project-level AGENT_SERVICE_URL SHADOWS
# the value Vercel generates from the binding, so `web` reads an empty string and every call
# fails with a URL parse error that says nothing about a service.

# --- Yours, everywhere ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Local only. On a deployment these come from the PLATFORM, not from you -----------
# Vercel   : generated by the binding in vercel.json. Never set it in the dashboard.
# Railway  : you DO set this one, to http://agent.railway.internal:3001 (no binding concept).
AGENT_SERVICE_URL=http://localhost:3001

# The port the agent listens on. Both platforms inject this; a project-wide value would be
# inherited by every service, including ones that must listen elsewhere.
PORT=3001
