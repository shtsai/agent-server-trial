# Vercel: build context is this service's root, so nothing above it is reachable.
FROM node:22-alpine
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev
COPY src ./src
COPY tsconfig.json ./
# Vercel scales this down after 5 minutes without traffic -- so it serves HTTP and is driven by
# POST /drain from a cron, rather than polling. The worker arm lives on Railway.
CMD ["npm", "start"]
