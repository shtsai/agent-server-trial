{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "bindings": [
        { "type": "service", "service": "agent", "format": "url", "env": "AGENT_SERVICE_URL" }
      ]
    },
    "agent": {
      "root": "services/agent-rs/",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
